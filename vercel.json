    },
    {
      "source": "/kenny-blue-boss-wayne{/}?",
      "destination": "/conciertos/2026/kenny-blues-boss-wayne-gira-espana-2026/",
      "permanent": true
    },
    {
      "source": "/bywater-call{/}?",
      "destination": "/conciertos/2026/bywater-call-16-06-2026/",
      "permanent": true
    },
    {
      "source": "/bywater-call-2{/}?",
      "destination": "/conciertos/2026/bywater-call-17-06-2026/",
      "permanent": true
    },
    {
      "source": "/alvaro-suite-tenerife{/}?",
      "destination": "/conciertos/2026/alvaro-suite-tenerife-30-04-2026/",
      "permanent": true
    },
    {
      "source": "/ana-curra{/}?",
      "destination": "/conciertos/2026/ana-curra-11-04-2026/",
      "permanent": true
    },
    {
      "source": "/clearwater-creedence-revival-telde{/}?",
      "destination": "/conciertos/2026/clearwater-creedence-revival-telde-14-11-2026/",
      "permanent": true
    },
    {
      "source": "/clearwater-creedence-revival-el-sauzal{/}?",
      "destination": "/conciertos/2026/clearwater-creedence-revival-el-sauzal-13-11-2026/",
      "permanent": true
    },
    {
      "source": "/clearwater-creedence-revival{/}?",
      "destination": "/conciertos/2026/clearwater-creedence-revival-telde-14-11-2026/",
      "permanent": true
    },

    {
      "source": "/the-doors-in-concert-gira-espanola{/}?",
      "destination": "/conciertos-anteriores/",
      "permanent": true
    },
    {
      "source": "/michaels-legacy{/}?",
      "destination": "/conciertos-anteriores/",
      "permanent": true
    },
    {
      "source": "/the-next-movement{/}?",
      "destination": "/conciertos-anteriores/",
      "permanent": true
    },

    {
      "source": "/contactar{/}?",
      "destination": "/contacto/",
      "permanent": true
    },

    {
      "source": "/sitemap_index.xml",
      "destination": "/sitemap.xml",
      "permanent": true
    },
    {
      "source": "/page-sitemap.xml",
      "destination": "/sitemap.xml",
      "permanent": true
    },
    {
      "source": "/post-sitemap.xml",
      "destination": "/sitemap.xml",
      "permanent": true
    },
    {
      "source": "/event_listing-sitemap.xml",
      "destination": "/sitemap.xml",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/conciertos/(.*)\\.(jpg|jpeg|png|webp|avif|ico|svg)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/pub-la-calle/(.*)\\.(jpg|jpeg|png|webp|avif|ico)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/favicon.ico",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "salanproducciones.vercel.app"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ]
}
