{
  "redirects": [
    {
      "source": "/wp-admin(.*)",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/wp-login.php",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/wp-content(.*)",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/feed(.*)",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/xmlrpc.php",
      "destination": "/",
      "permanent": true
    },

    {
      "source": "/poseidon-rock-fest{/}?",
      "destination": "/conciertos/2026/poseidon-rock-fest-13-06-2026/",
      "permanent": true
    },
    {
